#!/usr/bin/env bash
# rclaude: Claude Code with its work on another machine, in one of two ways.
#
#   rclaude <host> [--cwd <dir>] [--root <dir>]... [--server <path>] [--name <name>] [claude args...]
#     Claude Code runs here; its file and shell tools run on <host>.
#   rclaude <host> --on-host [--cwd <dir>] [--session <name>] [--command <cmd>] [--server <path>] [claude args...]
#     Claude Code runs on <host> in tmux, and pasting an image with ctrl+v reads this machine's clipboard.
#
# <host> is anything `ssh` accepts (an alias from ~/.ssh/config, user@host, an IP).
# Every argument rclaude does not recognise is passed to `claude`.
set -euo pipefail

# The whole script is one block, read in full before any of it runs: bash otherwise reads a script
# as it goes, and replacing this file under a running session would have it run the new file from
# the old one's offset.
{

usage() {
  cat >&2 <<'EOF'
usage: rclaude <host> [options] [claude args...]

  --cwd <dir>      the remote shell's starting directory, and the session's working tree;
                   a relative path is relative to the remote home directory (write
                   `src/app`, not `~/src/app`, which your local shell expands)
  --root <dir>     a remote directory the file tools may touch (repeatable; default: --cwd,
                   or the remote home directory)
  --server <path>  the remote-claude binary on the host (default: $HOME/.cargo/bin/remote-claude,
                   where `cargo install` puts it; $HOME expands on the host)
  --name <name>    the MCP server name, which prefixes the tool names (default: from <host>)
  --on-host        run Claude Code on the host instead, in a tmux session that survives
                   disconnecting, with ctrl+v image paste from this machine's clipboard
  --session <name> the tmux session for --on-host; an existing one is reattached
                   (default: the last part of --cwd, or claude)
  --ssh            for --on-host, connect with ssh even when mosh is installed on both ends
  --command <cmd>  for --on-host, a shell command for a new tmux session to run instead of
                   claude; a claude it starts still pastes from this machine's clipboard

Anything else is passed to claude, e.g. `rclaude devbox --cwd src/app --resume`.
EOF
  exit 2
}

# This script, by absolute path: the Monitor hook and the link daemon run it again.
self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")

# Single-quoted for a shell: the local one, or the remote one that splits the command ssh hands it.
shell_quote() {
  local escaped="'\\''"
  printf "'%s'" "${1//\'/$escaped}"
}

# As shell_quote, but a leading ~/ is left outside the quotes so the remote shell expands it.
remote_quote() {
  local s=$1
  # shellcheck disable=SC2088 # the tilde is for the remote shell to expand
  if [[ $s == "~/"* ]]; then
    printf '~/%s' "$(shell_quote "${s#\~/}")"
  else
    shell_quote "$s"
  fi
}

json_string() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# One held connection per host: every server launch and monitor is a channel on it, so a tool
# call is one round trip. BatchMode because nothing can answer a prompt: the session's stdin and
# stdout are the MCP stream.
ssh_opts=(-T
  -o BatchMode=yes
  -o ControlMaster=auto
  -o "ControlPath=$HOME/.ssh/rclaude-%C"
  -o ControlPersist=10m
  -o ServerAliveInterval=30)

# The PreToolUse hook on Monitor: rewrites its command to run on the host, in the working tree.
# Claude Code runs a tool with its original input, here locally, when a hook fails in any way but
# exit 2, so every failure must become exit 2; the caller maps a non-zero return to it.
monitor_hook() {
  local host=$1 cwd=$2 input command script wrapped o
  input=$(cat) || return 1
  if ! command=$(jq -er 'select(.tool_input.ws == null) | .tool_input.command // empty' <<<"$input"); then
    echo "Only command monitors are available in this session, and they run on $host." >&2
    return 1
  fi
  script=$command
  [[ -z $cwd ]] || script="cd $(remote_quote "$cwd") || exit; $command"
  wrapped=ssh
  for o in "${ssh_opts[@]}" "$host" "$script"; do
    wrapped+=" $(shell_quote "$o")"
  done
  jq -n --argjson input "$input" --arg command "$wrapped" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "allow",
      updatedInput: ($input.tool_input + {command: $command})}}'
}

if [[ ${1-} == --monitor-hook ]]; then
  [[ $# -eq 3 ]] || exit 2
  if ! out=$(monitor_hook "$2" "$3"); then
    echo "rclaude: the monitor was not started, because its command could not be moved to $2." >&2
    exit 2
  fi
  printf '%s\n' "$out"
  exit 0
fi

[[ $# -gt 0 && $1 != -* ]] || usage
host=$1
shift

cwd=
roots=()
# shellcheck disable=SC2016 # $HOME is for the remote shell to expand
server='$HOME/.cargo/bin/remote-claude'
name=
on_host=
no_mosh=
daemon=
session=
command=
claude_args=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --cwd | --root | --server | --name | --session | --command)
      [[ $# -ge 2 ]] || usage
      case $1 in
        --cwd) cwd=$2 ;;
        --root) roots+=("$2") ;;
        --server) server=$2 ;;
        --name) name=$2 ;;
        --session) session=$2 ;;
        --command) command=$2 ;;
      esac
      shift 2
      ;;
    --on-host)
      on_host=1
      shift
      ;;
    --ssh)
      no_mosh=1
      shift
      ;;
    --link-daemon)
      daemon=1
      shift
      ;;
    -h | --help) usage ;;
    *)
      claude_args+=("$1")
      shift
      ;;
  esac
done

# The link back to this machine (src/link.rs): the host's `xclip` and `open` are remote-claude
# under those names, and reach this responder through a forwarded port with the token. `clip`
# answers with the clipboard as PNG, read the way Claude Code itself reads it on macOS, or nothing.
# `open <size> <name>` takes a file and opens a copy here, if it is a document or an image: the
# host does not decide what this machine opens, so the name is cleaned and the type checked here,
# and the copy is quarantined like any download. Perl because every Mac has it.
# shellcheck disable=SC2016 # Perl's variables, not the shell's
link_responder='
use strict;
use IO::Socket::UNIX;
use File::Path qw(make_path);
my ($sock, $token, $png, $downloads) = @ARGV;
my %openable = map { $_ => 1 } qw(pdf png jpg jpeg gif webp heic svg html htm md txt csv tsv json log mp4 mov webm mp3 wav);
my $max = 100 << 20;
my $server = IO::Socket::UNIX->new(Type => SOCK_STREAM(), Local => $sock, Listen => 5) or exit 1;
while (my $client = $server->accept) {
  my $line = <$client>;
  if (defined $line) {
    chomp $line;
    my ($t, $verb, $rest) = split / /, $line, 3;
    if (defined $verb && $t eq $token) {
      print $client "rclaude 1\n";
      if ($verb eq "clip") {
        unlink $png;
        system("osascript", "-e", "set png_data to (the clipboard as «class PNGf»)",
          "-e", "set fp to open for access POSIX file \"$png\" with write permission",
          "-e", "write png_data to fp", "-e", "close access fp");
        if (open(my $fh, "<:raw", $png)) { local $/; print $client scalar <$fh>; close $fh; }
        unlink $png;
      } elsif ($verb eq "open" || $verb eq "reveal") {
        print $client open_file($client, $rest // "", $verb eq "reveal");
      }
    }
  }
  close $client;
}
sub open_file {
  my ($client, $rest, $reveal) = @_;
  my ($size, $name) = split / /, $rest, 2;
  return "error bad request\n" unless defined $name && $size =~ /^\d+$/;
  return "error larger than 100 MB\n" if $size > $max;
  $name =~ s{.*/}{};
  $name =~ s/[^A-Za-z0-9._ -]/_/g;
  $name =~ s/^[. ]+//;
  my ($stem, $ext) = $name =~ /^(.+)\.([A-Za-z0-9]+)$/;
  return "error only documents and images are opened, and $name is neither\n" unless defined $ext && $openable{lc $ext};
  my $body = "";
  while (length($body) < $size) {
    my $n = read($client, $body, $size - length($body), length($body));
    return "error the file arrived incomplete\n" unless $n;
  }
  make_path($downloads);
  my $path = "$downloads/$name";
  for (my $i = 1; -e $path; $i++) { $path = "$downloads/$stem-$i.$ext"; }
  open(my $fh, ">:raw", $path) or return "error cannot write $path\n";
  print $fh $body;
  close $fh;
  system("xattr", "-w", "com.apple.quarantine", sprintf("0081;%x;rclaude;", time), $path);
  system("open", $reveal ? ("-R", $path) : ($path)) == 0 or return "error saved $path but could not open it\n";
  return "ok $path\n";
}
'

# The link back to this machine (src/link.rs) is one per host, shared by every rclaude session to
# it: the responder above and one ssh carrying a forwarded port to it, kept connected by
# `rclaude <host> --link-daemon` for as long as any session to that host is open. One per pane
# meant one connection per pane, and a burst of them after the host restarted. Tailscale SSH
# creates a forwarded Unix socket owned by root, so the forward is a TCP port on the host's
# loopback, and the token keeps the host's other users off it. macOS only: elsewhere link_port
# stays empty and the host's `xclip` and `open` find no link.
link_port=
link_token=
link_root=${XDG_STATE_HOME:-$HOME/.local/state}/rclaude/link
link_dir_for() { printf '%s/%s' "$link_root" "${1//[^A-Za-z0-9_.@-]/_}"; }
link_alive() { [[ -f $1/pid ]] && kill -0 "$(cat "$1/pid")" 2>/dev/null; }

# This session's registration, removed on exit; the daemon stops once none are left.
cleanup_files=()
# shellcheck disable=SC2317,SC2329 # run by the trap
cleanup() {
  [[ ${#cleanup_files[@]} -eq 0 ]] || rm -f "${cleanup_files[@]}"
}
trap cleanup EXIT
# A closed terminal is a hangup, which would end this without the EXIT trap.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Joins the host's link, starting it if no session has: sets link_port.
use_link() {
  local dir
  [[ $(uname) == Darwin ]] && command -v perl >/dev/null || return 0
  dir=$(link_dir_for "$host")
  mkdir -p "$dir/users"
  : >"$dir/users/$$"
  cleanup_files+=("$dir/users/$$")
  if ! link_alive "$dir"; then
    # One starter at a time; a lock older than a minute is from a starter that died.
    if mkdir "$dir/lock" 2>/dev/null || { [[ -n $(find "$dir/lock" -maxdepth 0 -mmin +1 2>/dev/null) ]] && rm -rf "$dir/lock" && mkdir "$dir/lock" 2>/dev/null; }; then
      if ! link_alive "$dir"; then
        rm -f "$dir/port"
        nohup "$self" "$host" --link-daemon >/dev/null 2>&1 </dev/null &
        disown
      fi
      rmdir "$dir/lock"
    fi
  fi
  for _ in $(seq 50); do
    [[ -s $dir/port ]] && break
    sleep 0.1
  done
  link_port=$(cat "$dir/port" 2>/dev/null || true)
}

# The daemon: the responder, and the ssh that carries the link, reconnected whenever it drops.
link_daemon() {
  local dir sock child='' resp='' idle=0 f
  dir=$(link_dir_for "$host")
  mkdir -p "$dir/users"
  umask 077
  echo $$ >"$dir/pid"
  sock=$dir/link.sock
  link_token=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
  link_port=$((20000 + RANDOM % 40000))
  # shellcheck disable=SC2329 # run by the trap
  stop() {
    [[ -z $child ]] || kill "$child" 2>/dev/null
    [[ -z $resp ]] || kill "$resp" 2>/dev/null
    rm -f "$dir/pid" "$dir/port" "$sock" "$dir/clip.png"
  }
  trap stop EXIT
  trap 'exit 0' INT TERM
  trap '' HUP
  while :; do
    if [[ -z $resp ]] || ! kill -0 "$resp" 2>/dev/null; then
      rm -f "$sock"
      perl -e "$link_responder" "$sock" "$link_token" "$dir/clip.png" \
        "$HOME/Downloads/rclaude/${host//[^A-Za-z0-9_.-]/_}" 2>/dev/null &
      resp=$!
      for _ in $(seq 50); do
        [[ -S $sock ]] && break
        sleep 0.1
      done
      echo "$link_port" >"$dir/port"
    fi
    if [[ -z $child ]] || ! kill -0 "$child" 2>/dev/null; then
      # -tt: a terminal on the host, so the sleep is hung up when this connection ends.
      ssh -o ControlMaster=no -o ControlPath=none -o ServerAliveInterval=30 -o BatchMode=yes \
        -tt -o ExitOnForwardFailure=yes -R "127.0.0.1:$link_port:$sock" "$host" \
        "$(link_record) && exec sleep 2147483647" </dev/null >/dev/null 2>&1 &
      child=$!
    fi
    sleep 5
    for f in "$dir"/users/*; do
      [[ -e $f ]] || continue
      kill -0 "${f##*/}" 2>/dev/null || rm -f "$f"
    done
    if compgen -G "$dir/users/*" >/dev/null; then
      idle=0
    elif ((idle += 5)) && ((idle >= 60)); then
      exit 0
    fi
  done
}

# For the host's shell, before anything else: links xclip, osascript, open and xdg-open to
# remote-claude (xclip is how Claude Code reads the clipboard on Linux, osascript on macOS). The
# link's connection records itself as ~/.rclaude-links/<port>, holding its token; the host's side
# tries the newest first and moves on from one that has ended.
link_install() {
  # shellcheck disable=SC2016 # for the host's shell to expand
  printf '%s' 'mkdir -p ~/.local/share/rclaude/bin && for n in xclip osascript open xdg-open; do ln -sfn '"$server"' ~/.local/share/rclaude/bin/$n; done'
}
link_record() {
  printf '%s' "(umask 077 && mkdir -p ~/.rclaude-links && printf '%s\\n' $link_token > ~/.rclaude-links/$link_port)"
}

# The PATH the host's programs run with, so they find those links first.
# shellcheck disable=SC2016 # for the host's shell to expand
link_path='PATH="$HOME/.local/share/rclaude/bin:$PATH"; export PATH'

# Claude Code on the host, in tmux. Over mosh when both ends have it: mosh echoes keystrokes
# locally and survives sleep and network changes, which ssh does neither of. The link is the
# host's shared one, on its own connection either way.
run_on_host() {
  local inner script remote a status mosh_ready=
  use_link
  [[ -n $link_port ]] || echo "rclaude: pasting and opening on this machine need macOS; continuing without them" >&2
  inner="$link_path; "
  if [[ -n $command ]]; then
    inner+=$command
  else
    inner+='exec claude'
    for a in ${claude_args[@]+"${claude_args[@]}"}; do
      inner+=" $(shell_quote "$a")"
    done
  fi
  script="tmux new-session -A -s $(shell_quote "$session")"
  [[ -z $cwd ]] || script+=" -c $(remote_quote "$cwd")"
  script+=" $(shell_quote "$inner")"
  # Claude Code on a macOS host reads a pasted image natively from that machine's own pasteboard,
  # never asking the osascript link (src/paste.rs), so there ctrl+v is bound in tmux to put this
  # machine's clipboard image on the host's pasteboard first, then send the key on to the pane.
  # shellcheck disable=SC2016 # for the host's shell to expand
  script='if [ "$(uname)" = Darwin ]; then exec '"$script"' \; bind-key -n C-v run-shell "'"$server"' paste-sync #{pane_id}"; else exec '"$script"'; fi'

  local ssh=(ssh -o ControlMaster=no -o ControlPath=none -o ServerAliveInterval=30)
  if [[ -z $no_mosh ]] && command -v mosh >/dev/null &&
    "${ssh[@]}" -T "$host" "$(link_install) && command -v mosh-server >/dev/null" </dev/null; then
    mosh_ready=1
  fi

  if [[ -n $mosh_ready ]]; then
    # A login shell, so PATH has whatever the user's profile adds, such as where claude is
    # installed. mosh-server needs a UTF-8 locale the host has, and C.UTF-8 is the one every
    # Linux has; it would otherwise take this machine's, which the host may lack.
    # shellcheck disable=SC2016 # for the host's shell to expand
    remote='exec "${SHELL:-/bin/sh}" -lc '"$(shell_quote "$link_path; $script")"
    status=0
    mosh --server='LC_ALL=C.UTF-8 mosh-server' --ssh='ssh -o ControlMaster=no -o ControlPath=none' \
      "$host" -- sh -c "$remote" || status=$?
    return $status
  fi

  # shellcheck disable=SC2016 # for the host's shell to expand
  remote='exec "${SHELL:-/bin/sh}" -lc '"$(shell_quote "$(link_install) && $script")"
  ssh+=(-t)
  status=0
  "${ssh[@]}" "$host" "$remote" || status=$?
  return $status
}

if [[ -n $daemon ]]; then
  link_daemon
  exit 0
fi

if [[ -n $on_host ]]; then
  session=${session:-$(basename "${cwd:-claude}")}
  session=${session//[^A-Za-z0-9_-]/_}
  run_on_host
  exit $?
fi

# The MCP server name is part of every tool name (mcp__<name>__read), which allows only these characters.
name=${name:-$host}
name=${name//[^A-Za-z0-9_-]/_}

# The host's shared link, so `open` in the remote bash reaches this machine.
use_link
remote="$(link_install) && $link_path && exec $server serve"
for root in ${roots[@]+"${roots[@]}"}; do
  remote+=" --root $(remote_quote "$root")"
done
if [[ -n $cwd ]]; then
  [[ ${#roots[@]} -gt 0 ]] || remote+=" --root $(remote_quote "$cwd")"
  remote+=" --cwd $(remote_quote "$cwd")"
fi

ssh_json=
for a in "${ssh_opts[@]}" "$host" "$remote"; do
  ssh_json+=${ssh_json:+, }$(json_string "$a")
done
mcp_config="{\"mcpServers\": {$(json_string "$name"): {\"type\": \"stdio\", \"command\": \"ssh\", \"args\": [$ssh_json]}}}"

# A bare-name deny takes a tool out of Claude's context entirely, so Claude sees only the remote
# set. Every tool that reads local files or runs local commands must be on it or redirected:
# leaving Grep out once had Claude read a local README with it and report it as the remote one. A
# name the running build lacks draws a startup warning, so retired tools (MultiEdit, NotebookRead,
# LS) are left off.
deny='"Read", "Edit", "Write", "NotebookEdit", "Grep", "Glob", "Bash", "DesignSync", "EnterWorktree", "ExitWorktree"'
hooks=
monitor_note=
# Monitor runs its command in a local shell. With jq here to read the hook's input, a hook moves
# the command to the host; the `|| exit 2` refuses the monitor even if this script cannot run.
if command -v jq >/dev/null; then
  hook="$(shell_quote "$self") --monitor-hook $(shell_quote "$host") $(shell_quote "$cwd") || exit 2"
  hooks=", \"hooks\": {\"PreToolUse\": [{\"matcher\": \"Monitor\", \"hooks\": [{\"type\": \"command\", \"command\": $(json_string "$hook")}]}]}"
  monitor_note=" Monitor commands run on \`$host\` too, in that directory."
else
  deny+=', "Monitor"'
fi
settings="{\"permissions\": {
  \"deny\": [$deny],
  \"allow\": [\"mcp__${name}__read\", \"mcp__${name}__edit\", \"mcp__${name}__write\", \"mcp__${name}__bash\", \"mcp__${name}__bash_jobs\"]
}$hooks}"

# Claude Code's environment block (platform, working directory, shell) describes this machine and
# outranks an MCP server's instructions; without this, asked where it is working, Claude names
# the local machine.
where=${cwd:-the remote home directory}
prompt="You are working on the remote machine \`$host\`, not on the machine Claude Code runs on. \
Your only file and shell tools are mcp__${name}__*; there are no local ones. \
Your working directory is $where on \`$host\`; answer questions about where you are or what you \
are working on from there, not from the local environment above.$monitor_note"
[[ -z $link_port ]] || prompt+=" To show the user a document or image, run \`open <file>\` on \`$host\`: \
it opens a copy on the machine they are at."

# Claude Code keys session history and project memory by the directory it starts in. An empty
# directory per host and remote working tree gives each its own, and leaves no local checkout to
# mistake for the remote one.
tree=${cwd:-home}
tree=${tree//[^A-Za-z0-9_.-]/_}
state=${XDG_STATE_HOME:-$HOME/.local/state}/rclaude/$name/$tree
mkdir -p "$state"
cd "$state"

# Not exec'd: the link's responder is stopped when Claude Code exits.
status=0
claude --strict-mcp-config --settings "$settings" --append-system-prompt "$prompt" \
  ${claude_args[@]+"${claude_args[@]}"} --mcp-config "$mcp_config" || status=$?
exit $status
}
