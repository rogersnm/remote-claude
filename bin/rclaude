#!/usr/bin/env bash
# rclaude: start Claude Code with its file and shell tools on another machine.
#
#   rclaude <host> [--cwd <dir>] [--root <dir>]... [--server <path>] [--name <name>] [claude args...]
#
# <host> is anything `ssh` accepts (an alias from ~/.ssh/config, user@host, an IP).
# Every argument rclaude does not recognise is passed to `claude`.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: rclaude <host> [options] [claude args...]

  --cwd <dir>      the remote shell's starting directory, and the session's working tree;
                   a relative path is relative to the remote home directory (write
                   `src/app`, not `~/src/app`, which your local shell expands)
  --root <dir>     a remote directory the file tools may touch (repeatable; default: --cwd,
                   or the remote home directory)
  --server <path>  the remote-claude binary on the host (default: $HOME/.cargo/bin/remote-claude,
                   where `cargo install` puts it; $HOME expands on the host)
  --name <name>    the MCP server name, which prefixes the tool names (default: from <host>)

Anything else is passed to claude, e.g. `rclaude devbox --cwd src/app --resume`.
EOF
  exit 2
}

# Single-quoted for a shell: the local one, or the remote one that splits the command ssh hands it.
shell_quote() {
  local escaped="'\\''"
  printf "'%s'" "${1//\'/$escaped}"
}

# As shell_quote, but a leading ~/ is left outside the quotes so the remote shell expands it.
remote_quote() {
  local s=$1
  # shellcheck disable=SC2088 # the tilde is for the remote shell to expand
  if [[ $s == "~/"* ]]; then
    printf '~/%s' "$(shell_quote "${s#\~/}")"
  else
    shell_quote "$s"
  fi
}

json_string() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# One held connection per host: every server launch and monitor is a channel on it, so a tool
# call is one round trip. BatchMode because nothing can answer a prompt: the session's stdin and
# stdout are the MCP stream.
ssh_opts=(-T
  -o BatchMode=yes
  -o ControlMaster=auto
  -o "ControlPath=$HOME/.ssh/rclaude-%C"
  -o ControlPersist=10m
  -o ServerAliveInterval=30)

# The PreToolUse hook on Monitor: rewrites its command to run on the host, in the working tree.
# Claude Code runs a tool with its original input, here locally, when a hook fails in any way but
# exit 2, so every failure must become exit 2; the caller maps a non-zero return to it.
monitor_hook() {
  local host=$1 cwd=$2 input command script wrapped o
  input=$(cat) || return 1
  if ! command=$(jq -er 'select(.tool_input.ws == null) | .tool_input.command // empty' <<<"$input"); then
    echo "Only command monitors are available in this session, and they run on $host." >&2
    return 1
  fi
  script=$command
  [[ -z $cwd ]] || script="cd $(remote_quote "$cwd") || exit; $command"
  wrapped=ssh
  for o in "${ssh_opts[@]}" "$host" "$script"; do
    wrapped+=" $(shell_quote "$o")"
  done
  jq -n --argjson input "$input" --arg command "$wrapped" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "allow",
      updatedInput: ($input.tool_input + {command: $command})}}'
}

if [[ ${1-} == --monitor-hook ]]; then
  [[ $# -eq 3 ]] || exit 2
  if ! out=$(monitor_hook "$2" "$3"); then
    echo "rclaude: the monitor was not started, because its command could not be moved to $2." >&2
    exit 2
  fi
  printf '%s\n' "$out"
  exit 0
fi

[[ $# -gt 0 && $1 != -* ]] || usage
host=$1
shift

cwd=
roots=()
# shellcheck disable=SC2016 # $HOME is for the remote shell to expand
server='$HOME/.cargo/bin/remote-claude'
name=
claude_args=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --cwd | --root | --server | --name)
      [[ $# -ge 2 ]] || usage
      case $1 in
        --cwd) cwd=$2 ;;
        --root) roots+=("$2") ;;
        --server) server=$2 ;;
        --name) name=$2 ;;
      esac
      shift 2
      ;;
    -h | --help) usage ;;
    *)
      claude_args+=("$1")
      shift
      ;;
  esac
done

# The MCP server name is part of every tool name (mcp__<name>__read), which allows only these characters.
name=${name:-$host}
name=${name//[^A-Za-z0-9_-]/_}

remote="$server serve"
for root in ${roots[@]+"${roots[@]}"}; do
  remote+=" --root $(remote_quote "$root")"
done
if [[ -n $cwd ]]; then
  [[ ${#roots[@]} -gt 0 ]] || remote+=" --root $(remote_quote "$cwd")"
  remote+=" --cwd $(remote_quote "$cwd")"
fi

ssh_json=
for a in "${ssh_opts[@]}" "$host" "$remote"; do
  ssh_json+=${ssh_json:+, }$(json_string "$a")
done
mcp_config="{\"mcpServers\": {$(json_string "$name"): {\"type\": \"stdio\", \"command\": \"ssh\", \"args\": [$ssh_json]}}}"

# A bare-name deny takes a tool out of Claude's context entirely, so Claude sees only the remote
# set. Every tool that reads local files or runs local commands must be on it or redirected:
# leaving Grep out once had Claude read a local README with it and report it as the remote one. A
# name the running build lacks draws a startup warning, so retired tools (MultiEdit, NotebookRead,
# LS) are left off.
deny='"Read", "Edit", "Write", "NotebookEdit", "Grep", "Glob", "Bash", "DesignSync", "EnterWorktree", "ExitWorktree"'
hooks=
monitor_note=
# Monitor runs its command in a local shell. With jq here to read the hook's input, a hook moves
# the command to the host; the `|| exit 2` refuses the monitor even if this script cannot run.
if command -v jq >/dev/null; then
  self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
  hook="$(shell_quote "$self") --monitor-hook $(shell_quote "$host") $(shell_quote "$cwd") || exit 2"
  hooks=", \"hooks\": {\"PreToolUse\": [{\"matcher\": \"Monitor\", \"hooks\": [{\"type\": \"command\", \"command\": $(json_string "$hook")}]}]}"
  monitor_note=" Monitor commands run on \`$host\` too, in that directory."
else
  deny+=', "Monitor"'
fi
settings="{\"permissions\": {
  \"deny\": [$deny],
  \"allow\": [\"mcp__${name}__read\", \"mcp__${name}__edit\", \"mcp__${name}__write\", \"mcp__${name}__bash\", \"mcp__${name}__bash_jobs\"]
}$hooks}"

# Claude Code's environment block (platform, working directory, shell) describes this machine and
# outranks an MCP server's instructions; without this, asked where it is working, Claude names
# the local machine.
where=${cwd:-the remote home directory}
prompt="You are working on the remote machine \`$host\`, not on the machine Claude Code runs on. \
Your only file and shell tools are mcp__${name}__*; there are no local ones. \
Your working directory is $where on \`$host\`; answer questions about where you are or what you \
are working on from there, not from the local environment above.$monitor_note"

# Claude Code keys session history and project memory by the directory it starts in. An empty
# directory per host and remote working tree gives each its own, and leaves no local checkout to
# mistake for the remote one.
tree=${cwd:-home}
tree=${tree//[^A-Za-z0-9_.-]/_}
state=${XDG_STATE_HOME:-$HOME/.local/state}/rclaude/$name/$tree
mkdir -p "$state"
cd "$state"

exec claude --strict-mcp-config --settings "$settings" --append-system-prompt "$prompt" \
  ${claude_args[@]+"${claude_args[@]}"} --mcp-config "$mcp_config"
